# Host port published by the Caddy edge proxy.
EDGE_PORT=8080

# PowerDNS API endpoint the backend talks to.
# The default targets the demo PowerDNS container of this compose stack.
# To manage a real PowerDNS instead, point it at its API and use the real key:
#   PDNS_API_URL=http://10.0.0.12:8081/api/v1
PDNS_API_URL=http://pdns:8081/api/v1
PDNS_API_KEY=changeme-dev-key
